# Copy to `.env` and fill in. Never commit `.env`.

# Flask --------------------------------------------------------------
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database -----------------------------------------------------------
# Default: SQLite at access_control/app.db. Override for Postgres/MySQL.
# DATABASE_URL=sqlite:///app.db
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname

# Uploads ------------------------------------------------------------
# Absolute path to the directory where enrolled face images are saved.
# Defaults to <repo>/access_control/uploads if unset.
# UPLOAD_FOLDER=/var/lib/access_control/uploads

# Server -------------------------------------------------------------
# Defaults: 127.0.0.1:5000 (loopback only). Set HOST=0.0.0.0 only behind a reverse proxy.
HOST=127.0.0.1
PORT=5000

# Initial admin bootstrap (one-time use) ----------------------------
# When set, `python run.py --bootstrap-admin` creates this admin then exits.
# Leave unset in production; create admins via a separate provisioning step.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=

# Rate limiting ------------------------------------------------------
# In-memory by default. Use Redis in production (e.g. redis://localhost:6379/0).
# RATELIMIT_STORAGE_URI=memory://
